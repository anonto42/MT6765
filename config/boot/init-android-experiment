#!/bin/busybox sh
# WalPad: try to boot stock Android from the repaired `super`; on any failure fall
# back to the Linux server init (/init.server).
# Keep /dev minimal, like Android's first-stage init: pre-created nodes get the early
# "tmpfs" SELinux label and ueventd cannot relabel them later.
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
/bin/busybox --install -s /bin 2>/dev/null
mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null
mount -t tmpfs -o mode=0755 tmpfs /dev 2>/dev/null
# NB: no 2>/dev/null redirect before /dev/null exists (it would create a regular file)
mknod /dev/null c 1 3
mknod /dev/kmsg c 1 11 2>/dev/null
mknod /dev/random c 1 8 2>/dev/null
mknod /dev/urandom c 1 9 2>/dev/null
mknod /dev/ptmx c 5 2 2>/dev/null
chmod 666 /dev/null /dev/random /dev/urandom /dev/ptmx 2>/dev/null; chmod 600 /dev/kmsg 2>/dev/null
klog() { echo "WALPAD-ANDROID: $*" > /dev/kmsg 2>/dev/null; }
fallback() { klog "FALLBACK to server: $*"; echo > /proc/sys/kernel/hotplug 2>/dev/null; /bin/busybox mdev -s 2>/dev/null; exec /init.server; }
[ -c /dev/null ] || fallback "/dev/null is not a char device"
klog "=== android boot attempt (minimal /dev, dm-linear) ==="

# block device node from sysfs "major:minor"
mkblk() { n="$1"; i=0; while [ ! -e /sys/class/block/$n/dev ] && [ $i -lt 20 ]; do sleep 1; i=$((i+1)); done; [ -e /sys/class/block/$n/dev ] || return 1; mknod /dev/$n b $(tr ':' ' ' < /sys/class/block/$n/dev); }

# persistent boot log into the spare "metadata" partition (mmcblk0p8), flushed quickly
echo 4096 > /proc/sys/vm/dirty_background_bytes 2>/dev/null
echo 10 > /proc/sys/vm/dirty_expire_centisecs 2>/dev/null
echo 10 > /proc/sys/vm/dirty_writeback_centisecs 2>/dev/null
LOGDEV=/dev/mmcblk0p8
if mkblk mmcblk0p8; then
  dd if=/dev/zero of=$LOGDEV bs=65536 count=40 2>/dev/null
  ( ( dmesg; cat /proc/kmsg ) > $LOGDEV 2>/dev/null ) &
fi

SLOT=_a
case "$(cat /proc/cmdline)" in *slot_suffix=_b*) SLOT=_b;; esac
[ "$SLOT" = "_a" ] || fallback "slot is $SLOT, only slot a is wired up"

SUPER=/dev/mmcblk0p40
mkblk mmcblk0p40 || fallback "no super"

# device-mapper control node (minor is dynamic, listed in /proc/misc)
DM=$(grep ' device-mapper$' /proc/misc | tr -s ' ' | cut -d' ' -f1 | tr -d ' ')
[ -n "$DM" ] || fallback "no device-mapper in /proc/misc"
mkdir -p /dev/mapper
mknod /dev/mapper/control c 10 $DM

# logical partitions inside super (LP metadata, data/super/layout.json), bytes -> 512B sectors
mkdir -p /sysroot
/bin/dmlinear system_a  $SUPER $((2302672896/512)) $((1202814976/512)) || fallback "dm system_a"
/bin/dmlinear vendor_a  $SUPER $((1996488704/512)) $((305889280/512))  || fallback "dm vendor_a"
/bin/dmlinear product_a $SUPER $((1048576/512))    $((1994551296/512)) || fallback "dm product_a"
mount -t ext4 -o ro /dev/mapper/system_a /sysroot || fallback "mount system"
[ -x /sysroot/system/bin/init ] || fallback "system image has no /system/bin/init"
mount -t ext4 -o ro /dev/mapper/vendor_a /sysroot/vendor || fallback "mount vendor"
mount -t ext4 -o ro /dev/mapper/product_a /sysroot/product || fallback "mount product"
klog "system/vendor/product mounted via dm-linear"

# remove my temporary nodes (open fds, e.g. the logger's, stay valid) so ueventd creates everything with proper labels
rm -rf /dev/mapper /dev/mmcblk0p40 /dev/mmcblk0p8
echo > /proc/sys/kernel/hotplug 2>/dev/null

# --- mimic Android first-stage init's filesystem setup ---
mkdir -p /dev/pts /dev/socket
mount -t devpts devpts /dev/pts 2>/dev/null
mkdir -p /sys/fs/selinux 2>/dev/null
mount -t selinuxfs selinuxfs /sys/fs/selinux 2>/dev/null && klog "selinuxfs mounted" || klog "selinuxfs mount FAILED"
mount -t tmpfs -o nosuid,nodev,noexec,mode=0755 tmpfs /mnt 2>/dev/null
mkdir -p /mnt/vendor /mnt/product
mount --move /dev /sysroot/dev || fallback "move /dev"
mount --move /proc /sysroot/proc || fallback "move /proc"
mount --move /sys /sysroot/sys || fallback "move /sys"
mount --move /mnt /sysroot/mnt 2>/dev/null
export INIT_STARTED_AT=$(cut -d' ' -f1 /proc/uptime | tr -d .)0
exec switch_root /sysroot /system/bin/init selinux_setup
