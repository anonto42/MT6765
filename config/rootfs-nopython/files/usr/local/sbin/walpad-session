#!/bin/sh
# Graphical session of the no-Python image: X (Xvfb + fbmirror), window manager, Rust shell.
# Touch, keys, screen timeout and the rest are done by walpad-core (started by walpad-init).
# Anything that cannot run ends in walpad-rescue (padui) and the session then idles, so init does
# not restart it (restarting would put X and fbmirror back on top of padui).
export PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
export HOME=/root DISPLAY=:0 XDG_RUNTIME_DIR=/run/walpad
# software rendering only (no GPU user space) and no browser sandbox (no user namespaces in this kernel)
export LIBGL_ALWAYS_SOFTWARE=1 MOZ_DISABLE_CONTENT_SANDBOX=1 MOZ_DISABLE_GMP_SANDBOX=1 MOZ_DISABLE_RDD_SANDBOX=1 \
       MOZ_DISABLE_SOCKET_PROCESS_SANDBOX=1 MOZ_WEBRENDER=0 MOZ_ACCELERATED=0 GTK_A11Y=none NO_AT_BRIDGE=1
RUN=/run/walpad
klog() { echo "WALPAD-SESSION: $*" > /dev/kmsg 2>/dev/null; }
rescue_and_idle() { klog "rescue: $*"; walpad-rescue "$*"; while :; do sleep 3600; done; }
mkdir -p $RUN
[ -d $RUN/rescue.d ] && rescue_and_idle "rescue already active: $(cat $RUN/rescue.d/reason 2>/dev/null)"

# Every subsystem must be Rust and capable; otherwise there is nothing to run (no fallback implementation).
WHY=$(walpad-rust-check) || rescue_and_idle "$WHY"
klog "runtime: device=rust input=rust shell=rust"

pkill Xvfb 2>/dev/null; pkill fbmirror 2>/dev/null; pkill openbox 2>/dev/null; pkill -f 'walpad-supervise shell' 2>/dev/null; pkill -x walpad-shell 2>/dev/null; sleep 1
rm -f /run/walpad-ok /tmp/.X0-lock /tmp/.X11-unix/X0
mkdir -p /tmp/.X11-unix; chmod 1777 /tmp/.X11-unix

# The kernel has no VT (CONFIG_VT is not set), so a real Xorg cannot start.  Xvfb renders into an
# in-memory framebuffer file and fbmirror copies it to /dev/fb0; touch is injected through XTEST.
mkdir -p /run/walpad/xfb
klog "starting Xvfb"
Xvfb :0 -screen 0 1280x1280x24 -fbdir /run/walpad/xfb -nolisten tcp -ac >> /var/log/Xvfb.log 2>&1 &
i=0; while [ ! -S /tmp/.X11-unix/X0 ] && [ $i -lt 40 ]; do sleep 1; i=$((i+1)); done
[ -S /tmp/.X11-unix/X0 ] || rescue_and_idle "Xvfb did not start"
klog "Xvfb is up"
echo 0 > /run/walpad/orientation
fbmirror /run/walpad/xfb/Xvfb_screen0 >> /var/log/fbmirror.log 2>&1 &
xset s off; xset -dpms; xset s noblank
xsetroot -solid '#0b0e16' 2>/dev/null
openbox --config-file /etc/walpad/openbox-rc.xml >> /var/log/openbox.log 2>&1 &
sleep 1
# The shell runs in its own restart loop: a shell crash does not restart X or close apps.  3 exits
# within 10 s in a row stop the loop and call walpad-rescue.
walpad-supervise shell --require Xvfb --on-fallback "walpad-rescue walpad-shell exited 3 times within 10 s" -- walpad-shell >> /var/log/walpad-shell.log 2>&1
[ -d $RUN/rescue.d ] && rescue_and_idle "rescue already active: $(cat $RUN/rescue.d/reason 2>/dev/null)"
if [ ! -f /run/walpad-ok ]; then
  # Xvfb died before the shell showed its first frame, or the ramdisk health check killed it at
  # 150 s.  Do not restart X: the ramdisk owns the fallback to padui in that case.
  rescue_and_idle "Xvfb gone before the session reported healthy"
fi
klog "Xvfb is gone after a healthy start: restarting the session"
exit 1
