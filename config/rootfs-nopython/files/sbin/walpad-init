#!/bin/sh
# WalPad system init.  Runs INSIDE a chroot started by the boot ramdisk (which stays PID 1), so a
# bug here can never panic the kernel.  /dev /proc /sys are bind mounts of the ramdisk's.
export PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
export HOME=/root
klog() { echo "WALPAD-OS: $*" > /dev/kmsg 2>/dev/null; }
klog "walpad-init started"

/bin/busybox --install -s 2>/dev/null
hostname walpad 2>/dev/null
hwclock -s -u 2>/dev/null   # system time from the RTC (kept right by the network sync in walpad-wifi)
mkdir -p /var/log /var/lib/walpad /run/walpad /tmp/.X11-unix /root/.ssh /etc/dropbear
walpad-logcap    # trim logs left by earlier boots (they live on the ext4 rootfs); then every 5 min below
chmod 1777 /tmp /tmp/.X11-unix
ip link set lo up 2>/dev/null
# Terminals need devpts: the ramdisk bind-mounts its /dev here without the /dev/pts submount, so
# openpty() failed with ENODEV and st/xterm exited at once.  Mount a devpts instance inside this root.
mkdir -p /dev/pts
mountpoint -q /dev/pts || mount -t devpts devpts /dev/pts -o gid=5,mode=620,ptmxmode=666 2>/dev/null || klog "could not mount /dev/pts"
[ -c /dev/ptmx ] || ln -sf pts/ptmx /dev/ptmx
# Safe mode (card M9.2): Volume Down held at start.  It is decided FIRST (the key is only held for a few seconds
# after power-on); SSH and Wi-Fi still start below; the core and the graphical session are skipped and show the rescue UI (padui, from the rootfs) instead.  The
# marker /run/walpad-ok tells the ramdisk the session is "healthy", so its 150 s fallback does not
# start a second padui on the same framebuffer.
SAFE=""
if walpad-safemode-check; then
  SAFE=1; klog "SAFE MODE: Volume Down held, not starting the core or the session; padui on the panel"
  echo "volume-down held at boot" > /run/walpad/safemode; : > /run/walpad-ok
  ( while :; do padui >> /var/log/padui.log 2>&1; sleep 1; done ) &
fi

[ -s /etc/resolv.conf ] || printf 'nameserver 1.1.1.1\nnameserver 8.8.8.8\n' > /etc/resolv.conf

# first boot: grow the filesystem to fill the partition, build the font cache
if [ ! -f /var/lib/walpad/firstboot-done ]; then
  klog "first boot: resize2fs + fc-cache"
  ( resize2fs /dev/mmcblk0p44 > /var/log/resize.log 2>&1 ) &
  fc-cache -f > /var/log/fc-cache.log 2>&1
  touch /var/lib/walpad/firstboot-done
fi

# Android logical partitions inside super (stock Walton Android 11): the Wi-Fi/Bluetooth firmware,
# kernel modules and the vendor user-space blobs live there.  Offsets from data/super/layout.json.
SUPER=/dev/mmcblk0p40
DM=$(grep ' device-mapper$' /proc/misc | tr -s ' ' | cut -d' ' -f1 | tr -d ' ')
mkdir -p /dev/mapper /system /vendor /product
[ -c /dev/mapper/control ] || { [ -n "$DM" ] && mknod /dev/mapper/control c 10 $DM; }
mkdm() {  # name offset-bytes length-bytes mountpoint
  [ -b /dev/mapper/$1 ] || dmlinear $1 $SUPER $(($2/512)) $(($3/512)) 2>&1 | head -2 | while read l; do klog "dmlinear: $l"; done
  mountpoint -q $4 || mount -t ext4 -o ro /dev/mapper/$1 $4 2>/dev/null || klog "could not mount $1 at $4"
}
if [ -b $SUPER ] && [ -n "$DM" ]; then
  mkdm system_a  2302672896 1202814976 /system
  mkdm vendor_a  1996488704 305889280  /vendor
  mkdm product_a 1048576    1994551296 /product
else
  klog "no super / device-mapper: Wi-Fi stack unavailable"
fi

# Kernel firmware loading (request_firmware: the MediaTek WMT patches, WIFI_RAM_CODE, regulatory.db)
# runs in kernel threads, and those still have the boot ramdisk as their root: switch_root only changed
# the root of init and its children.  There /vendor does not exist, so the kernel answered "file not
# found" (-2) and the radio never powered on.  Bind the firmware folders into that old root, reached
# through kthreadd's /proc/2/root.  Harmless when the roots are the same (no switch_root).
if [ -d /vendor/firmware ] && ! [ /proc/2/root/. -ef / ]; then
  for fwd in /vendor/firmware /lib/firmware; do
    [ -d $fwd ] || continue
    mkdir -p /proc/2/root$fwd 2>/dev/null
    mount --bind $fwd /proc/2/root$fwd 2>/dev/null && klog "firmware: $fwd visible to kernel threads" || klog "firmware: cannot bind $fwd into the boot root"
  done
fi

# SSH (keys only; password login disabled)
[ -f /etc/dropbear/dropbear_ed25519_host_key ] || dropbearkey -t ed25519 -f /etc/dropbear/dropbear_ed25519_host_key > /dev/null 2>&1
if [ -s /root/.ssh/authorized_keys ]; then
  chmod 700 /root /root/.ssh; chmod 600 /root/.ssh/authorized_keys
  dropbear -s -R -E -p 22 >> /var/log/dropbear.log 2>&1
fi

# Wi-Fi: stack bring-up, association and reconnection (own loop, never blocks the session)
( walpad-wifi >> /var/log/walpad-wifi.log 2>&1 ) &

if [ -z "$SAFE" ]; then
# Rust core (own restart loop, outside the session so a UI/X crash never stops it).  There is no
# second implementation in this image: if the core is not usable the session rescues (padui), and
# if it crashes 3 times in a row walpad-rescue hands the panel to padui.
RT_DEVICE=$(walpad-runtime WALPAD_DEVICE); RT_INPUT=$(walpad-runtime WALPAD_INPUT); RT_SHADOW=$(walpad-runtime WALPAD_SHADOW)
if [ "$RT_DEVICE" = rust ] || [ "$RT_INPUT" = rust ] || [ "$RT_SHADOW" = 1 ]; then
  CORE_ARGS=""; [ "$RT_SHADOW" = 1 ] && CORE_ARGS="--shadow"
  [ "$RT_DEVICE" = rust ] && CORE_ARGS="$CORE_ARGS --device"; [ "$RT_INPUT" = rust ] && CORE_ARGS="$CORE_ARGS --input"
  klog "starting walpad-core ($CORE_ARGS) device=$RT_DEVICE input=$RT_INPUT"
  ( walpad-supervise core --on-fallback "walpad-rescue walpad-core exited 3 times within 10 s" -- walpad-core $CORE_ARGS >> /var/log/walpad-core.log 2>&1 ) &
fi

# graphical session with automatic restart
( while true; do walpad-session >> /var/log/walpad-session.log 2>&1; klog "session exited, restarting in 3 s"; sleep 3; done ) &

fi  # SAFE

klog "walpad-init finished starting services"
# main loop: log size caps (card M9.1).  Init itself is the keeper, no extra daemon.
while true; do sleep "${WALPAD_LOGCAP_INTERVAL:-300}"; walpad-logcap; done
