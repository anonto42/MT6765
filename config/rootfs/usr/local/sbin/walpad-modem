#!/bin/sh
# walpad-modem: boot the MediaTek modem (MD1, LTE/WCDMA/GSM) the way Android's vendor init does,
# using the stock vendor daemons through Android's linker (same method as walpad-wifi).
#   walpad-modem start   mount the modem's NV partitions, start ccci_fsd + ccci_mdinit, wait for MD
#   walpad-modem status  print the modem state (no side effects)
#   walpad-modem data on|off|status   mobile data (owner request 2026-11-10; see data_on below);
#                        prints key=value lines: state=on|off|failed, reason, ip, apn
# The NV partitions hold the IMEI and RF calibration: backups are in firmware/MT6765/backups/modem-*
# (host) and /mnt/sd/walpad-backup (tablet).  ccci_fsd writes to them like Android does.
SYS=/system/system
# the modem daemons are 32-bit ARM: 32-bit linker, libraries and property shim (tools/propshim32)
LINKER=$SYS/bin/bootstrap/linker
SHIM=/usr/local/lib/libwpdprops32.so
# The 32-bit shim has its OWN property file.  /tmp/wpd-props belongs to the Wi-Fi stack (64-bit shim,
# reads only its first 8 KB): putting hundreds of build.prop lines there hid the chip id from
# wmt_launcher and Wi-Fi/Bluetooth never started (2026-11-10).
PROPS=/tmp/wpd-props32
RUN=/run/walpad
say() { echo "[modem] $*"; echo "WALPAD-MODEM: $*" > /dev/kmsg 2>/dev/null; }

partdev() {  # GPT name -> mmcblk0pN
  for f in /sys/class/block/mmcblk0p*/uevent; do
    [ "$(sed -n 's/^PARTNAME=//p' "$f")" = "$1" ] && { sed -n 's/^DEVNAME=//p' "$f"; return 0; }
  done; return 1
}

by_name() {  # Android paths /dev/block/platform/bootdevice/by-name/<part> (and /dev/block/by-name)
  mkdir -p /dev/block/platform/bootdevice/by-name
  ln -sfn platform/bootdevice/by-name /dev/block/by-name 2>/dev/null
  for f in /sys/class/block/mmcblk0p*/uevent; do
    n=$(sed -n 's/^PARTNAME=//p' "$f"); d=$(sed -n 's/^DEVNAME=//p' "$f")
    [ -n "$n" ] && ln -sfn "/dev/$d" "/dev/block/platform/bootdevice/by-name/$n"
  done
}

mount_nv() {  # part mountpoint
  d=$(partdev "$1") || { say "no partition $1"; return 1; }
  mkdir -p "$2"; mountpoint -q "$2" && return 0
  mount -t ext4 -o noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc "/dev/$d" "$2" || { say "cannot mount $1"; return 1; }
}

# The ccci kernel driver only accepts some ioctls (MD start) from a process named ccci_mdinit, and
# a process started as "linker /vendor/bin/x" is named "linker": run each daemon through a symlink
# to the linker carrying the daemon's name, so the kernel sees the right process name.
LDIR=$RUN/android-bin
running() { pgrep -f "^$LDIR/$1 /vendor/bin/$1( |$)" >/dev/null 2>&1; }

vendor_daemon() {  # name args...: run a vendor binary through the bionic linker with the property shim;
  # publishes init.svc.vendor.<name>=running like Android's init (ccci_mdinit waits for it)
  n=$1; shift
  mkdir -p $LDIR; ln -sfn "$LINKER" "$LDIR/$n"
  running "$n" || ( export LD_LIBRARY_PATH=$SYS/lib/bootstrap:/vendor/lib:$SYS/lib LD_PRELOAD=$SHIM
    setsid "$LDIR/$n" "/vendor/bin/$n" "$@" >> "/var/log/walpad-$n.log" 2>&1 < /dev/null & )
  echo "init.svc.vendor.$n=running" >> $PROPS; echo "init.svc.$n=running" >> $PROPS
}

md_state() { timeout 2 cat /sys/kernel/ccci/md_en 2>/dev/null; }

# ---- mobile data (owner request 2026-11-10; link sequence: docs/42-mobile-data-link.md) ---------
# The AT channel is gsm0710muxd's pseudo-terminal; one opener at a time (walpad-core pauses its own
# AT polling while this runs).  WALPAD_MODEM_ROOT prefixes the paths (host tests only).
# MediaTek's NetAgent (inside libmtk-ril) owns two more channels: pttynwcmd (commands: the interface
# confirmation `AT+EIF=<id>, "ifst", "up", <type>`) and pttynwurc (URCs: `+EIF: <id>, ifup, ...`).
MR=${WALPAD_MODEM_ROOT:-}
AT_TTY=$MR/dev/radio/pttycmd1
NW_CMD=$MR/dev/radio/pttynwcmd
NW_URC=$MR/dev/radio/pttynwurc
MOBILE_CONF=$MR/etc/walpad/mobile.conf
LINK_HOOK=$MR/usr/local/sbin/walpad-modem-link
DATA_STATE=$MR/run/walpad/mobile-data
NW_STATE=$MR/run/walpad/mobile-nw     # tid=<transIntfId> type=<address type>, read by `data off`
URC_LOG=$MR/run/walpad/nwurc.log
RUNDIR=$MR/run/walpad

# at_tty <device> "<command>" [timeout_s]: one AT command; prints the reply lines (echo and OK
# removed).  0 = OK, 1 = ERROR / +CME ERROR (printed), 2 = no channel or timeout.  Runs in a
# subshell so a failed open never ends the script.
at_tty() (
  tty=$1; shift
  [ -e "$tty" ] || exit 2
  exec 3<>"$tty" || exit 2
  stty -F "$tty" raw -echo 2>/dev/null
  printf '%s\r' "$1" >&3
  end=$(( $(date +%s) + ${2:-5} ))
  while :; do
    left=$(( end - $(date +%s) )); [ "$left" -gt 0 ] || exit 2
    IFS= read -r -t "$left" line <&3 || exit 2
    line=$(printf '%s' "$line" | tr -d '\r')
    case $line in
      ""|"$1") ;;
      OK) exit 0 ;;
      ERROR|"+CME ERROR"*|"+CMS ERROR"*|"NO CARRIER") echo "$line"; exit 1 ;;
      *) echo "$line" ;;
    esac
  done
)
at() { at_tty "$AT_TTY" "$@"; }
# NetAgent commands go to the netagent channel; without it (other muxer setups) to the main one
atn() { if [ -e "$NW_CMD" ]; then at_tty "$NW_CMD" "$@"; else at_tty "$AT_TTY" "$@"; fi; }

apn_for() {  # operator name -> APN (Bangladesh operators; "internet" otherwise)
  case $(printf '%s' "$1" | tr 'A-Z' 'a-z') in
    *grameen*|gp) echo gpinternet ;;
    *robi*|*airtel*) echo internet ;;
    *banglalink*) echo blweb ;;
    *teletalk*) echo wap ;;
    *) echo internet ;;
  esac
}

result() {  # state reason ip apn: the key=value answer, also kept for `data status`
  { echo "state=$1"; [ -n "$2" ] && echo "reason=$2"; [ -n "$3" ] && echo "ip=$3"; [ -n "$4" ] && echo "apn=$4"; } > "$DATA_STATE.tmp"
  mkdir -p "${DATA_STATE%/*}"; mv -f "$DATA_STATE.tmp" "$DATA_STATE" 2>/dev/null
  cat "$DATA_STATE" 2>/dev/null || echo "state=$1"
}

# NetAgent URC reader: started BEFORE the context is activated, because `+EIF: <id>, ifup, ...`
# arrives while AT+CGACT is still running.  <id> % 100 is the ccmni interface number.
urc_start() {
  URC_PID=; mkdir -p "${URC_LOG%/*}"; : > "$URC_LOG"
  [ -e "$NW_URC" ] || return 0
  stty -F "$NW_URC" raw -echo 2>/dev/null
  cat "$NW_URC" >> "$URC_LOG" 2>/dev/null &
  URC_PID=$!
}
urc_stop() { [ -n "$URC_PID" ] && kill "$URC_PID" 2>/dev/null; URC_PID=; }
urc_lines() { tr -d '\r' < "$URC_LOG" 2>/dev/null; }
wait_ifup() {  # [seconds]: prints the last "+EIF: <id>, ifup, <type>, <ip>, ..." line; 1 = none
  i=0
  while :; do
    l=$(urc_lines | grep -a '^+EIF: *[0-9][0-9]*, *ifup,' | tail -n 1)
    [ -n "$l" ] && { echo "$l"; return 0; }
    [ $i -ge ${1:-8} ] && return 1
    sleep 1; i=$((i+1))
  done
}

# NetAgent::confirmInterfaceState: tells the modem the AP side of the interface is up/down.
# The exact line the RIL builds: AT+EIF=<transIntfId>, "ifst", "up"|"down", <addr type 1=v4>
confirm_ifst() {  # tid type up|down
  c="AT+EIF=$1, \"ifst\", \"$3\", $2"
  atn "$c" >/dev/null && return 0
  [ -e "$NW_CMD" ] && at "$c" >/dev/null && return 0   # the main channel as a fallback
  return 1
}

data_on_run() {
  mkdir -p "${DATA_STATE%/*}"
  [ -e "$AT_TTY" ] || { result failed "the modem is not running"; return 1; }
  apn=$(sed -n 's/^apn=//p' "$MOBILE_CONF" 2>/dev/null | tail -n 1)
  case $apn in *[!A-Za-z0-9._-]*) apn= ;; esac
  if [ -z "$apn" ]; then
    at "AT+COPS=3,0" >/dev/null
    op=$(at "AT+COPS?" | sed -n 's/^+COPS: *[0-9]*,[0-9]*,"\([^"]*\)".*/\1/p')
    apn=$(apn_for "$op")
  fi
  say "data on: apn $apn"
  at "AT+EDALLOW=1" >/dev/null   # MediaTek: allow packet data (harmless where unknown)
  # what NetAgent::init sends once: the AP handles interface configuration (capability bitmap 3)
  [ -e "$RUNDIR/mobile-eifconfig" ] || { atn "AT+EIFCONFIG=3" >/dev/null; : > "$RUNDIR/mobile-eifconfig"; }
  urc_start
  at "AT+CGDCONT=1,\"IP\",\"$apn\"" >/dev/null || { result failed "the modem rejected the APN" "" "$apn"; return 1; }
  at "AT+CGACT=1,1" 25 >/dev/null || { result failed "could not activate the data context (no network?)" "" "$apn"; return 1; }
  ip=$(at "AT+CGPADDR=1" | sed -n 's/^+CGPADDR: *1, *"\{0,1\}\([0-9.]*\).*/\1/p')
  dns=$(at "AT+CGCONTRDP=1" | sed -n 's/^+CGCONTRDP: *//p' | head -n 1 | tr -d '"')
  dns1=$(echo "$dns" | cut -d, -f6); dns2=$(echo "$dns" | cut -d, -f7)
  [ -n "$ip" ] || { result failed "the network gave no IP address" "" "$apn"; return 1; }
  # which interface? the modem names it in "+EIF: <id>, ifup, <type>, <ip>, ..." (id 302 = ccmni2)
  tid= ; type=1; mtu=
  if line=$(wait_ifup 8); then
    tid=$(echo "$line" | sed 's/^+EIF: *\([0-9]*\),.*/\1/')
    t=$(echo "$line" | cut -d, -f3 | tr -d ' '); case $t in [123]) type=$t ;; esac
    sleep 1   # the MTU URC follows the ifup one
    mtu=$(urc_lines | grep -a "^+EIF: *$tid, *mtu," | tail -n 1 | sed 's/.*, *\([0-9][0-9]*\) *$/\1/')
  else
    tid=302; say "data on: no ifup URC, assuming transIntfId $tid (unverified)"
  fi
  # binding the context to its ccmni interface is the hook's job (docs/42-mobile-data-link.md)
  if [ ! -x "$LINK_HOOK" ]; then
    say "data on: context active ($ip), no link hook"
    result failed "data link not supported yet" "$ip" "$apn"; return 1
  fi
  nif=ccmni$((tid % 100)); say "data on: transIntfId $tid -> $nif, ip $ip, mtu ${mtu:-default}"
  if WALPAD_MOBILE_IF=$nif "$LINK_HOOK" up "$ip" "$dns1" "$dns2" $mtu >/dev/null 2>&1; then
    echo "tid=$tid type=$type" > "$NW_STATE"
    confirm_ifst "$tid" "$type" up && say "data on: interface confirmed to the modem" || say "data on: the modem did not accept the ifst confirmation"
    result on "" "$ip" "$apn"
  else
    result failed "the data link did not come up" "$ip" "$apn"; return 1
  fi
}

data_on() { data_on_run; rc=$?; urc_stop; return $rc; }

data_off() {
  nif=
  if [ -f "$NW_STATE" ]; then
    tid=$(sed -n 's/^tid=\([0-9]*\) .*/\1/p' "$NW_STATE"); type=$(sed -n 's/.* type=\([0-9]*\)$/\1/p' "$NW_STATE")
    [ -n "$tid" ] && { nif=ccmni$((tid % 100)); confirm_ifst "$tid" "${type:-1}" down; }
    rm -f "$NW_STATE"
  fi
  [ -x "$LINK_HOOK" ] && WALPAD_MOBILE_IF=$nif "$LINK_HOOK" down >/dev/null 2>&1
  if [ -e "$AT_TTY" ] && ! at "AT+CGACT=0,1" 15 >/dev/null; then
    result failed "could not deactivate the data context"; return 1
  fi
  rm -f "$DATA_STATE"
  echo state=off
}

data_status() {
  if [ -f "$DATA_STATE" ] && grep -q '^state=on$' "$DATA_STATE"; then cat "$DATA_STATE"; else echo state=off; fi
}

case ${1:-status} in
  start)
    [ -x "$LINKER" ] || { say "bootstrap linker missing: /system not mounted"; exit 1; }
    by_name
    mount_nv nvdata /mnt/vendor/nvdata || exit 1
    mount_nv nvcfg /mnt/vendor/nvcfg || exit 1
    mount_nv protect1 /mnt/vendor/protect_f || exit 1
    mount_nv protect2 /mnt/vendor/protect_s || exit 1
    mkdir -p /mnt/vendor/nvdata/md /data/vendor/mdlpm /data/vendor/md3 /data/vendor_de/md $RUN
    # Android log socket stand-in so the vendor daemons' messages land in a file (socat, optional)
    mkdir -p /dev/socket
    if command -v socat >/dev/null 2>&1 && [ ! -S /dev/socket/logdw ]; then
      ( setsid socat -u UNIX-RECV:/dev/socket/logdw OPEN:/var/log/walpad-android.log,creat,append >/dev/null 2>&1 & )
    fi
    # Android's init loads the build properties first; the modem daemons read them (e.g.
    # ro.vendor.mtk_md1_support selects /dev/ttyC0 instead of an external USB modem)
    if ! grep -q "^ro.vendor.mtk_md1_support=" $PROPS 2>/dev/null; then
      for f in /system/system/build.prop /vendor/build.prop /vendor/default.prop; do
        # never copy the connectivity keys (persist.vendor.connsys.chipid=-1 in vendor build.prop):
        # walpad-wifi decides from this file whether wmt_loader already ran, and a stale "chipid"
        # line made it skip the loader, so Wi-Fi and Bluetooth never started
        [ -f "$f" ] && grep -E '^[a-zA-Z0-9_.-]+=' "$f" | grep -v -i -E 'connsys|chipid' >> $PROPS
      done
      echo "ro.boot.opt_sim_count=2" >> $PROPS
    fi
    vendor_daemon nvram_daemon
    i=0; while [ $i -lt 30 ] && ! grep -q "^vendor.service.nvram_init=Ready" $PROPS 2>/dev/null; do sleep 1; i=$((i+1)); done
    say "nvram_init: $(grep "^vendor.service.nvram_init=" $PROPS 2>/dev/null | tail -1)"
    vendor_daemon ccci_fsd 0
    sleep 1
    vendor_daemon ccci_mdinit 0
    i=0; while [ $i -lt 60 ]; do
      [ -c /dev/ttyC0 ] && grep -q "ready" /sys/kernel/ccci/md_en 2>/dev/null && break
      sleep 1; i=$((i+1))
    done
    say "after ${i}s: md1 status $(grep "^vendor.mtk.md1.status=" $PROPS | tail -1)"
    # AT channels: gsm0710muxd multiplexes /dev/ttyC0 into /dev/radio/pttycmd1.. (pseudo-terminals)
    mkdir -p /dev/radio
    vendor_daemon gsm0710muxd -s /dev/ttyC0 -f 512 -n 8 -m basic
    i=0; while [ $i -lt 20 ] && [ ! -e /dev/radio/pttycmd1 ]; do sleep 1; i=$((i+1)); done
    say "AT channels: $(ls /dev/radio 2>/dev/null | tr '\n' ' ')"
    ;;
  status)
    echo "md_en: $(md_state | tr '\n' ' ')"
    for n in nvram_daemon ccci_fsd ccci_mdinit gsm0710muxd; do printf '%s: %s\n' "$n" "$(running "$n" && echo running || echo stopped)"; done
    grep -E "^(vendor\.service\.nvram_init|vendor\.mtk\.md1\.status|mtk\.md1\.status)=" $PROPS 2>/dev/null | tail -3
    ;;
  data)
    case $2 in
      on) data_on ;;
      off) data_off ;;
      status) data_status ;;
      *) echo "usage: $0 data on|off|status" >&2; exit 2 ;;
    esac
    ;;
  *) echo "usage: $0 start|status|data on|off|status" >&2; exit 2 ;;
esac
