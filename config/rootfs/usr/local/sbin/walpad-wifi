#!/bin/sh
# Bring the MediaTek CONNSYS Wi-Fi stack up (sequence proven in scripts/mtk_stack_up.sh / wifi_assoc.sh)
# and keep the tablet associated.  Networks are stored in /etc/wpa_supplicant/wpa_supplicant.conf
# (managed by the Wi-Fi settings app through wpa_cli).  ORDER IS LOAD-BEARING: wmt_launcher must
# be serving before anything powers the chip on; a failed power-on can only be cleared by a reboot.
SYS=/system/system
LINKER=$SYS/bin/bootstrap/linker64
MODDIR=/vendor/lib/modules
SHIM=/usr/local/lib/libwpdprops.so
CONF=/etc/wpa_supplicant/wpa_supplicant.conf
IFACE=wlan0
say() { echo "[wifi] $*"; echo "WALPAD-WIFI: $*" > /dev/kmsg 2>/dev/null; }

mkdir -p /etc/wpa_supplicant /run/wpa_supplicant /run/walpad
[ -f $CONF ] || printf 'ctrl_interface=/run/wpa_supplicant\nctrl_interface_group=0\nupdate_config=1\ncountry=US\n' > $CONF
chmod 600 $CONF

stack_up() {
  [ -x $LINKER ] || { say "bootstrap linker missing: /system not mounted"; return 1; }
  export LD_LIBRARY_PATH=$SYS/lib64/bootstrap:/vendor/lib64:$SYS/lib64
  export LD_PRELOAD=$SHIM
  insmod_once() { grep -q "^$1 " /proc/modules && return 0; insmod $MODDIR/$1.ko && say "insmod $1"; }
  insmod_once wmt_drv || return 1
  if ! grep -q chipid /tmp/wpd-props 2>/dev/null; then
    $LINKER /vendor/bin/wmt_loader > /tmp/wmt_loader.log 2>&1
    i=0; while [ ! -c /dev/stpwmt ] && [ $i -lt 20 ]; do sleep 1; i=$((i+1)); busybox mdev -s 2>/dev/null; done
    [ -c /dev/stpwmt ] || { say "wmt_loader did not create /dev/stpwmt"; return 1; }
  fi
  insmod_once wmt_chrdev_wifi || return 1
  insmod_once wlan_drv_gen4m || return 1
  launcher_serving() { for p in $(ps -eo pid,args | grep -v grep | grep 'wmt_launcher' | awk '{print $1}'); do ls -l /proc/$p/fd 2>/dev/null | grep -q stpwmt && return 0; done; return 1; }
  if ! launcher_serving; then
    for p in $(ps -eo pid,args | grep -v grep | grep 'wmt_launcher' | awk '{print $1}'); do kill $p 2>/dev/null; done
    setsid $LINKER /vendor/bin/wmt_launcher -p /vendor/firmware/ -o 1 > /tmp/wmt_launcher.log 2>&1 < /dev/null &
    j=0; while ! launcher_serving && [ $j -lt 15 ]; do sleep 1; j=$((j+1)); done
    launcher_serving || { say "wmt_launcher not serving"; return 1; }
    say "wmt_launcher serving"
  fi
  DEVNUM=$(cat /sys/class/wmtWifi/wmtWifi/dev 2>/dev/null)
  [ -n "$DEVNUM" ] || { say "no /sys/class/wmtWifi"; return 1; }
  if [ ! -c /dev/wmtWifi ]; then rm -f /dev/wmtWifi; mknod /dev/wmtWifi c "${DEVNUM%%:*}" "${DEVNUM##*:}"; chmod 600 /dev/wmtWifi; fi
  if [ ! -d /sys/class/net/$IFACE ]; then
    dmesg -c > /dev/null 2>&1
    if echo 1 > /dev/wmtWifi 2>/tmp/wmton.err; then sleep 5
    else
      sleep 3; dmesg > /var/log/wmton.dmesg 2>/dev/null
      say "WMT power-on failed (first-attempt trace saved in /var/log/wmton.dmesg)"
      return 9
    fi
  fi
  [ -d /sys/class/net/$IFACE ] || { say "no $IFACE after power-on"; return 1; }
  unset LD_PRELOAD LD_LIBRARY_PATH
  ip link set $IFACE up 2>/dev/null
  say "$IFACE is up"
}

DONE_STACK=0
for attempt in 1 2 3; do
  stack_up; rc=$?
  if [ $rc = 0 ]; then DONE_STACK=1; break; fi
  [ $rc = 9 ] && break   # a failed power-on latches the chip until reboot: do not retry
  say "stack bring-up attempt $attempt failed"; sleep 5
done
[ $DONE_STACK = 1 ] || { say "giving up on Wi-Fi (reboot to retry)"; echo failed > /run/walpad/wifi-state; exit 1; }

# supplicant (Alpine's native build) and DHCP, with a reconnect loop
unset LD_PRELOAD LD_LIBRARY_PATH
cat > /run/walpad/udhcpc.script <<'SCR'
#!/bin/sh
case "$1" in
  bound|renew)
    ip addr flush dev $interface 2>/dev/null
    ip addr add $ip/${mask:-24} dev $interface
    ip link set $interface up
    [ -n "$router" ] && ip route replace default via ${router%% *} dev $interface
    : > /etc/resolv.conf; for d in $dns; do echo "nameserver $d" >> /etc/resolv.conf; done
    [ -s /etc/resolv.conf ] || printf 'nameserver 1.1.1.1\nnameserver 8.8.8.8\n' > /etc/resolv.conf ;;
esac
exit 0
SCR
chmod +x /run/walpad/udhcpc.script

# The owner's Wi-Fi switch (walpad-core `wifi_enable`, owner request 2026-11-10): "0" in
# $ENABLED_FILE = client off (missing = on, persists across reboots).  Off works at the network
# level only: the supplicant stops and wlan0 goes down; the chip stays powered (see above).
# walpad-hotspot creates $EXCL while an access point runs without STA+AP concurrency: the client is
# held off (wlan0 stays up for the AP) and resumes when the flag goes away.
ENABLED_FILE=/var/lib/walpad/wifi-enabled
EXCL=/run/walpad/hotspot-exclusive
DEVD_JSON=/etc/walpad/devd.json
json_str() {
  sed -n 's/.*"'"$1"'"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$DEVD_JSON" 2>/dev/null | head -n 1
}
mask_to_prefix() {
  case "$1" in
    255.255.255.255) echo 32 ;;
    255.255.255.128) echo 25 ;;
    255.255.255.0)   echo 24 ;;
    255.255.0.0)     echo 16 ;;
    255.0.0.0)       echo 8 ;;
    *)               echo 24 ;;
  esac
}
apply_hostname() {
  hn=$(json_str net_hostname)
  [ -n "$hn" ] || return 0
  cur_hn=$(cat /proc/sys/kernel/hostname 2>/dev/null)
  if [ "$cur_hn" != "$hn" ]; then
    printf '%s\n' "$hn" > /etc/hostname 2>/dev/null
    printf '%s\n' "$hn" > /proc/sys/kernel/hostname 2>/dev/null
    say "hostname set to $hn"
  fi
}
want_mac() {
  [ -s /run/walpad/wlan0.hwmac ] || tr 'A-F' 'a-f' < /sys/class/net/$IFACE/address > /run/walpad/wlan0.hwmac 2>/dev/null
  mode=$(json_str net_mac_mode)
  case "$mode" in
    custom)
      cm=$(json_str net_mac | tr 'A-F' 'a-f')
      [ -n "$cm" ] && { echo "$cm"; return; } ;;
    random)
      if [ ! -s /run/walpad/wlan0.randmac ]; then
        printf '02:%s\n' "$(od -An -N5 -tx1 /dev/urandom 2>/dev/null | tr -s ' ' ':' | sed 's/^://;s/:$//')" > /run/walpad/wlan0.randmac
      fi
      cat /run/walpad/wlan0.randmac 2>/dev/null; return ;;
  esac
  cat /run/walpad/wlan0.hwmac 2>/dev/null
}
apply_mac() {
  wm=$(want_mac)
  cm=$(tr 'A-F' 'a-f' < /sys/class/net/$IFACE/address 2>/dev/null)
  if [ -n "$wm" ] && [ -n "$cm" ] && [ "$wm" != "$cm" ]; then
    ip link set $IFACE down 2>/dev/null
    ip link set $IFACE address "$wm" 2>/dev/null && say "MAC set to $wm"
  fi
}
want_client() { [ "$(cat $ENABLED_FILE 2>/dev/null)" != 0 ] && [ ! -e $EXCL ]; }
sup_start() {
  pkill wpa_supplicant 2>/dev/null; sleep 1
  apply_hostname
  apply_mac
  ip link set $IFACE up 2>/dev/null
  iw dev $IFACE set power_save on >/dev/null 2>&1 || true
  # (no -f: Alpine's build has no debug-file support, so -f made it print its usage and exit)
  wpa_supplicant -B -i $IFACE -c $CONF -Dnl80211 -P /run/wpa_supplicant.pid >> /var/log/wpa_supplicant.log 2>&1
  echo started > /run/walpad/wifi-state
  say "client on"
}
sup_stop() {
  wpa_cli -p /run/wpa_supplicant -i $IFACE terminate > /dev/null 2>&1
  sleep 1; pkill wpa_supplicant 2>/dev/null
  pkill -f "udhcpc -i $IFACE" 2>/dev/null
  ip addr flush dev $IFACE 2>/dev/null
  if [ -e $EXCL ]; then say "client paused for the hotspot"
  else ip link set $IFACE down 2>/dev/null; say "client off (Wi-Fi switch)"; fi
}
CLIENT=unknown
while true; do
  if ! want_client; then
    [ "$CLIENT" = off ] || { sup_stop; CLIENT=off; }
    if [ -e $EXCL ]; then echo hotspot > /run/walpad/wifi-state; else echo disabled > /run/walpad/wifi-state; fi
    i=0; while [ $i -lt 4 ] && ! want_client; do sleep 1; i=$((i+1)); done
    continue
  fi
  if [ -e /run/walpad/wifi-reapply ]; then
    rm -f /run/walpad/wifi-reapply
    apply_hostname
    wm=$(want_mac)
    cm=$(tr 'A-F' 'a-f' < /sys/class/net/$IFACE/address 2>/dev/null)
    if [ -n "$wm" ] && [ -n "$cm" ] && [ "$wm" != "$cm" ]; then
      CLIENT=restarting
    else
      pkill -f "udhcpc -i $IFACE" 2>/dev/null
      ip -4 addr flush dev $IFACE 2>/dev/null
    fi
  fi
  [ "$CLIENT" = on ] || { sup_start; CLIENT=on; }
  state=$(wpa_cli -p /run/wpa_supplicant -i $IFACE status 2>/dev/null | sed -n 's/^wpa_state=//p')
  ip=$(ip -4 addr show $IFACE 2>/dev/null | sed -n 's/.*inet \([0-9.]*\).*/\1/p' | head -1)
  ip_mode=$(json_str net_ip_mode)
  cfg_ip=$(json_str net_ip)
  if [ "$state" = "COMPLETED" ]; then
    if [ "$ip_mode" = "manual" ] && [ -n "$cfg_ip" ]; then
      if [ "$ip" != "$cfg_ip" ]; then
        pkill -f "udhcpc -i $IFACE" 2>/dev/null
        pfx=$(mask_to_prefix "$(json_str net_mask)")
        gw=$(json_str net_gateway)
        ip -4 addr flush dev $IFACE 2>/dev/null
        ip addr add "$cfg_ip/$pfx" dev $IFACE 2>/dev/null
        ip link set $IFACE up 2>/dev/null
        [ -n "$gw" ] && ip route replace default via "$gw" dev $IFACE 2>/dev/null
        ip="$cfg_ip"
        say "static IP ok: $cfg_ip/$pfx${gw:+ via $gw}"
      fi
    elif [ -z "$ip" ]; then
      say "associated, requesting DHCP"
      hn=$(json_str net_hostname)
      if udhcpc -i $IFACE -n -q -t 6 ${hn:+-x hostname:$hn} -s /run/walpad/udhcpc.script > /dev/null 2>&1; then
        ip=$(ip -4 addr show $IFACE 2>/dev/null | sed -n 's/.*inet \([0-9.]*\).*/\1/p' | head -1)
        say "DHCP ok: $ip"
      else
        say "DHCP got no answer (will retry)"
      fi
    fi
  fi
  echo "${state:-none} ${ip:-}" > /run/walpad/wifi-state
  # network time once per boot (retried every ~60 s until it works), then into the RTC so the clock is
  # right after the next power-on even before Wi-Fi; a wrong clock breaks every HTTPS site in the browser
  if [ -n "$ip" ] && [ ! -f /run/walpad/time-synced ] && [ $(( $(date +%s) - ${LAST_NTP:-0} )) -ge 60 ]; then
    LAST_NTP=$(date +%s)
    if timeout 20 ntpd -n -q -p pool.ntp.org -p time.google.com -p time.cloudflare.com > /dev/null 2>&1; then
      touch /run/walpad/time-synced; hwclock -w -u 2>/dev/null; say "time synced: $(date -u '+%F %T') UTC"
    else
      say "time sync failed (will retry)"
    fi
  fi
  # the switch is checked every second, the rest every 4 s
  i=0; while [ $i -lt 4 ] && want_client && [ ! -e /run/walpad/wifi-reapply ]; do sleep 1; i=$((i+1)); done
done
