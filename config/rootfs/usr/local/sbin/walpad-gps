#!/bin/sh
# walpad-gps: bring up the MediaTek GNSS stack (CONNSYS GPS) with the stock vendor pieces.
#   walpad-gps start   load gps_drv.ko (needs wmt_drv from walpad-wifi), create the device nodes,
#                      mount the VNDK APEX (32-bit libcurl & co for mnld), start mnld
#   walpad-gps stop    stop mnld (the kernel module stays: never rmmod CONNSYS modules)
#   walpad-gps status
# Positions are not exported yet: mnld talks to the GNSS HAL over its sockets (mtk_hal2mnl /
# mtk_mnl2hal); a client for that is the next step.  Nothing here writes to a partition.
SYS=/system/system
LINKER=$SYS/bin/bootstrap/linker
SHIM=/usr/local/lib/libwpdprops32.so
RUN=/run/walpad
LDIR=$RUN/android-bin
APEX=$RUN/apex/vndk
say() { echo "[gps] $*"; echo "WALPAD-GPS: $*" > /dev/kmsg 2>/dev/null; }
running() { pgrep -f "^$LDIR/mnld /vendor/bin/mnld" >/dev/null 2>&1; }

mount_vndk() {
  mountpoint -q $APEX && return 0
  mkdir -p $APEX $RUN/apex/tmp
  ( cd $RUN/apex/tmp && [ -f apex_payload.img ] || timeout 60 unzip -o -q $SYS/apex/com.android.vndk.current.apex apex_payload.img ) || return 1
  mount -o loop,ro $RUN/apex/tmp/apex_payload.img $APEX
}

nodes() {
  for c in stpgps gpsemi gpsfwlog; do
    n=$(ls /sys/class/$c 2>/dev/null | head -1); [ -n "$n" ] || continue
    d=$(cat /sys/class/$c/$n/dev) || continue
    [ -e /dev/$n ] || mknod /dev/$n c "${d%%:*}" "${d##*:}"
  done
}

case ${1:-status} in
  start)
    [ -x "$LINKER" ] || { say "bootstrap linker missing: /system not mounted"; exit 1; }
    grep -q "^wmt_drv " /proc/modules || { say "wmt_drv not loaded (Wi-Fi stack down)"; exit 1; }
    grep -q "^gps_drv " /proc/modules || insmod /vendor/lib/modules/gps_drv.ko || { say "cannot load gps_drv"; exit 1; }
    nodes
    mount_vndk || { say "cannot mount the VNDK apex"; exit 1; }
    mkdir -p /data/vendor/gps /dev/socket $LDIR
    ln -sfn "$LINKER" "$LDIR/mnld"
    running || ( export LD_LIBRARY_PATH=$SYS/lib/bootstrap:/vendor/lib:$APEX/lib:$SYS/lib LD_PRELOAD=$SHIM
      setsid "$LDIR/mnld" /vendor/bin/mnld >> /var/log/walpad-mnld.log 2>&1 < /dev/null & )
    sleep 2; running && say "mnld running" || { say "mnld did not start"; exit 1; }
    ;;
  stop)
    for p in $(pgrep -f "^$LDIR/mnld /vendor/bin/mnld"); do kill "$p"; done; say "mnld stopped" ;;
  status)
    printf 'gps_drv: %s\n' "$(grep -q '^gps_drv ' /proc/modules && echo loaded || echo absent)"
    printf 'mnld: %s\n' "$(running && echo running || echo stopped)" ;;
  *) echo "usage: $0 start|stop|status" >&2; exit 2 ;;
esac
