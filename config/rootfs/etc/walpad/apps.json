[
  {"id": "browser", "name": "Browser", "icon": "globe", "exec": ["firefox-esr", "--new-instance", "about:blank"], "env": {}, "single_instance": true, "wm_class": "firefox-esr", "touch": "scroll"},
  {"id": "terminal", "name": "Terminal", "icon": "terminal", "exec": ["st", "-c", "term-st", "-f", "DejaVu Sans Mono:size=14", "-e", "tmux"], "env": {}, "single_instance": false, "wm_class": "term-st", "touch": "scroll", "max_instances": 6},
  {"id": "files", "name": "Files", "icon": "folder", "exec": ["pcmanfm", "/"], "env": {}, "single_instance": true, "wm_class": "pcmanfm", "touch": "scroll"},
  {"id": "gpicview", "name": "Photo viewer", "icon": "image", "exec": ["gpicview"], "env": {}, "single_instance": true, "wm_class": "gpicview", "touch": "scroll", "open": true, "open_args": ["--", "{path}"]},
  {"id": "kali", "name": "Kali", "icon": "terminal", "exec": ["st", "-c", "kali-st", "-f", "DejaVu Sans Mono:size=13", "-e", "/usr/local/sbin/walpad-kali", "shell"], "env": {}, "single_instance": false, "wm_class": "kali-st", "touch": "mouse", "max_instances": 3},
  {"id": "code", "name": "Code", "icon": "code", "exec": ["lite-xl"], "env": {"SDL_VIDEO_X11_WMCLASS": "lite-xl"}, "single_instance": true, "wm_class": "com.lite_xl.LiteXL", "touch": "scroll", "open": true, "open_args": ["{path}"]},
  {"id": "scanner", "name": "Scanner", "icon": "terminal", "exec": ["st", "-c", "scanner-st", "-f", "DejaVu Sans Mono:size=14", "-e", "fish", "-C", "echo '--- Virus scanner (ClamAV) ---'; echo 'walpad-scan update   # get/refresh virus definitions, needs network'; echo 'walpad-scan run      # scan your files and any SD card/USB drive'; echo; walpad-scan status"], "env": {}, "single_instance": false, "wm_class": "scanner-st", "touch": "scroll", "max_instances": 2}
]
