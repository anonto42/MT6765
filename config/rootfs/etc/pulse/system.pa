# WalPad 8G: PulseAudio uses module-null-sink ("walpad") and walpad-sound bridges
# walpad.monitor to hw:0,0 via parec | aplay.  Using module-alsa-sink directly on hw:0,0
# triggers a kernel_panic in the legacy mt-soc driver under video CPU load (snd_pcm_rewind/recover),
# whereas linear aplay writes are stable.  walpad-volume still controls software volume on "walpad".
load-module module-native-protocol-unix auth-anonymous=1 socket=/run/pulse/native
load-module module-null-sink sink_name=walpad sink_properties=device.description="WalPad"
set-default-sink walpad
# release the card after 10 s of silence (an idle PCM must not stay open)
# no suspend-on-idle: closing and re-opening the codec PCM repeatedly hung the tablet (2026-11-11)
#load-module module-suspend-on-idle timeout=10
